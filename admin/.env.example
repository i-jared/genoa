# Base URL of the Genoa Worker. Production: https://genoa-api.hp-accounts.workers.dev
GENOA_API_URL=http://localhost:8787
# Public origin of this admin app. The Worker must list the same value as its ADMIN_URL.
ADMIN_URL=http://localhost:3000
# At least 32 random characters, e.g. `openssl rand -base64 48`. Rotating it signs everyone out.
SESSION_SECRET=
