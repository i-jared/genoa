{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genoa-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "APP_URL": "https://genoa-api.hp-accounts.workers.dev",
    "ENVIRONMENT": "production",
    "LEGACY_APP_URL": "https://gather-api.hp-accounts.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "genoa",
      "database_id": "3f63164d-6333-4440-8e76-7c6aec5870bc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "genoa-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "ConversationRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ConversationRoom"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "genoa-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "genoa-jobs",
        "max_batch_size": 5,
        "max_retries": 5,
        "dead_letter_queue": "genoa-failed"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "workers_dev": true,
  "preview_urls": false
}
