{
  "name": "genoa-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "migrate:local": "wrangler d1 migrations apply genoa --local",
    "deploy": "wrangler deploy --config wrangler.production.jsonc",
    "migrate:production": "wrangler d1 migrations apply genoa --remote --config wrangler.production.jsonc"
  },
  "dependencies": {
    "better-auth": "1.7.5",
    "hono": "4.13.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.132.0"
  },
  "overrides": {
    "sharp@>=0.0.0 <0.35.5": "0.35.5",
    "undici@>=7.0.0 <7.30.1": "7.30.1"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "npm": ">=11.19.0"
  }
}
